  "validations": [
    {
      "id": "reference-input",
      "type": "at_least_one",
      "parameters": [
        "genome",
        "bwtIndex"
      ],
      "strict": true,
      "message": "Provide either genome or bwtIndex."
    },
    {
      "id": "reference-exclusive",
      "type": "at_most_one",
      "parameters": [
        "genome",
        "bwtIndex"
      ],
      "strict": false,
      "message": "Both genome and bwtIndex are set; genome takes precedence."
    },
    {
      "id": "containers-exclusive",
      "type": "at_most_one",
      "parameters": [
        "containersJSON",
        "containersDir"
      ],
      "strict": false,
      "message": "Both containersJSON and containersDir are set; containersJSON takes precedence."
    }
  ]
}
