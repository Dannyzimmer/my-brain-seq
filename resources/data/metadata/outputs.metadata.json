{
  "schema_version": 1,
  "groups": [
    {
      "id": "preprocessing",
      "label": "Preprocessing",
      "order": 1
    },
    {
      "id": "differential_expression",
      "label": "Differential expression",
      "order": 2
    },
    {
      "id": "functional",
      "label": "Functional analysis",
      "order": 3
    },
    {
      "id": "report",
      "label": "Report",
      "order": 4
    }
  ],
  "outputs": [
    {
      "id": "fastqc_html",
      "label": "FastQC HTML reports",
      "path": "${PARAM:fqcOut}",
      "kind": "file",
      "base": "outDir",
      "match": "*_fastqc.html",
      "role": "output",
      "required": false,
      "multiple": true,
      "order": 10,
      "group": "preprocessing"
    },
    {
      "id": "fastqc_zip",
      "label": "FastQC ZIP reports",
      "path": "${PARAM:fqcOut}",
      "kind": "file",
      "base": "outDir",
      "match": "*_fastqc.zip",
      "role": "output",
      "required": false,
      "multiple": true,
      "order": 11,
      "group": "preprocessing"
    },
    {
      "id": "cutadapt_reads",
      "label": "Adapter-trimmed reads",
      "path": "${PARAM:ctdOut}",
      "kind": "file",
      "base": "outDir",
