# REQUIRED
workingDir=/path/to/working-directory
gffFile=/path/to/mirbase_hsa.gff3
conditions=/path/to/conditions_file.txt
contrast=/path/to/contrast_file.txt

# OPTIONAL
fastqDir=input/fastq
outDir=output
organism=Homo sapiens
adapter=NA
genome=
bwtIndex=
bwt_additional_args=
gffFeature=miRNA
gffAttribute=Name
ft_additional_args=
qvalue=0.05
log2FC=0.5
distance_method=euclidean
vennFormat=png
selectDEAsoftware=both
containersJSON=FALSE
containersDir=FALSE
databasesDir=/resources/data/databases/
tarbaseDB=TarBase_v8_download.txt
reactomeDB=Ensembl2Reactome.txt
reactomeInteractionsDB=reactome.all_species.interactions.tab-delimited.txt

# OUTPUT DIRECTORIES
fqcOut=1_fastqc
ctdOut=2_cutadapt
bwtOut=3_bowtie
bamstOut=4_bam_stats
ftqOut=5_feature_counts
dsqOut=6_deseq2
edgOut=6_edger
deaIntOut=6_deseq2+edger
mqcOut=7_multiqc

# FLAGS
# runChecks
# skipPullDockerImages
# removeDockerImages
# deseqNormalizationHclust
# samtools_keep_sam_files
