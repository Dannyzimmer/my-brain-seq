#!/bin/bash
# WARNING:
# The following environment variable must be available:
#   _JSON_TEST : path to the JSON with the data of the tests (see INFO section).
#
#   Directory containing the tests must follow the pattern:
#            .
#            ├── Software_1
#            │   ├── test_01
#            │   │   └── test_config.json
#            │   ├── test_02
#            │   │   └── test_config.json
#            │   └── test_N
#            │       └── test_config.json
#            ├── Software_2
#            │   └── test_N
#            │       └── test_config.json
#            └── Software_N
#                └── ...
# INFO
# Variables are taken from a JSON (test_config.json) with the following format:
#     {
#         "pipeline_runner":"/path/to/pipeline/public/CLI",
#         "test_dir":"/path/to/test/dir/"
#     }

export _VERSION=1.3
export _PARAMS_FILENAME="compi.parameters"

if [[ -z "${_JSON_TEST}" ]]; then
    echo "ERROR: variable _JSON_TEST is unset or empty." >&2
    return 1
fi

if [[ ! -f "${_JSON_TEST}" ]]; then
    echo "ERROR: JSON not found in: '${_JSON_TEST}'." >&2
    return 1
fi

function center_text {
    local width="${1}"
    shift
    local text="$*"
    local text_len=${#text}

    if (( text_len >= width )); then
        printf "%s\n" "$text"
        return
    fi

    local pad_left=$(( (width - text_len) / 2 ))
    local pad_right=$(( width - text_len - pad_left ))

    printf "%*s%s%*s\n" "$pad_left" "" "$text" "$pad_right" ""
}

export _CONFIG_FILENAME="test_config.json"
export _TEST_NAME=$(jq -r '.test_name // "TEST"' "${_JSON_TEST}")
export _TEST_DESCRIPTION=$(jq -r '.description // " "' "${_JSON_TEST}")
export _TEST_MINUTES=$(jq -r '.minutes // "NA"' "${_JSON_TEST}")
export _SELF_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
export _SELF_NAME="$( basename "${BASH_SOURCE[0]}" )"
export _SELF="${_SELF_DIR}/${_SELF_NAME}"
export _WELCOME_MSG
export _PIPELINE_RUNNER="$(cat ${_JSON_TEST} | jq -r '.pipeline_runner')"
export _PIPELINE_NAME=$(basename "${_PIPELINE_RUNNER}")
export _PIPELINE_ROOT="$(dirname ${_PIPELINE_RUNNER})"
export _CURRENT_TEST="$(cat ${_JSON_TEST}| jq -r '.test_dir')"
export _SFW_DIR="$(dirname ${_CURRENT_TEST})"
export _SFW_NAME="$(basename ${_SFW_DIR})"
export _ROOT="$(dirname ${_SFW_DIR})"
export _PIPELINE_DB="${_CURRENT_TEST}/environment.db"
export _COMPI_PARAMS="${_CURRENT_TEST}/${_PARAMS_FILENAME}"
export _COMPI_PARAMS_TEMPLATE="${_PIPELINE_ROOT}/params-examples/${_PARAMS_FILENAME}"
export _ENVIRONMENT_DB_PATH="${_PIPELINE_DB}"
export _LOGS="${_CURRENT_TEST}/logs/"
export PIPEMAKER_PIPELINE="${_PIPELINE_ROOT}"

function _get_test_welcome_msg {
    local message
    local minutes=$(jq -r '.minutes // "NA"' "${_JSON_TEST}")
    local line_width=81
read -r -d '' message << EOM
▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒

$(center_text ${line_width} ${_PIPELINE_NAME})
$(center_text ${line_width} "- ${_TEST_NAME} -")
$(center_text ${line_width} "(${minutes} min)")

$(center_text ${line_width} ${_TEST_DESCRIPTION})

▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒

VARIABLES:

    _PIPELINE_ROOT : Path to the root of the pipeline.
    _PIPELINE_DB  : The DB file generated by EnvHandler.
    _COMPI_PARAMS : Path to the compi.parameters file.
    _CURRENT_TEST : Path to the test directory of the current software.

    Use \`showenv\` to get a full list of environment variables.

FUNCTIONS:

    runner : The CLI entrypoint of the pipeline.
    run : Runs the pipeline using the compi.parameters in the directory.
    tests : Runs the pipeline tests.
    log : Open the last log of the current test.
    ENV : Wrapper to use EnvHandler over the test database.
    SIF_MANAGER : Wrapper to use the SIF_MANAGER binary of the pipeline.
    diropen : Opens a Dolphin window on the current test directory.
    opendb : Opens the EnvHandler Database with DB Browser.
    showenv: Display the environment variables of the test.
    pipeMaker: pipeMaker CLI pointing to the current pipeline.
    goto : Go to the tests of another pipeline.
    switch : Switch to another available test of the current pipeline.
    inf : Display the information of the software tests.
    new : Creates a new test directory for the current software.
    del : Removes the selected test.
    helpme : Display this message.

___________________________________ v${_VERSION} _______________________________________
EOM
echo "${message}"
}

export _WELCOME_MSG="$(_get_test_welcome_msg)"

function runner {
    "${_PIPELINE_RUNNER}" "${@}"
}

function run {
    local args

    if [ "$#" -eq 0 ]; then
        args="--num-tasks 5"
    else
        args="$*"
    fi
    local start=$(date +%s)
    runner run "${_COMPI_PARAMS}" --add-params "$args"
    local elapsed=$(( $(date +%s) - start ))
    local minutes=$(( elapsed / 60 ))
    local seconds=$(( elapsed % 60 ))
    local time_str=$(printf "%d:%02d" "$minutes" "$seconds")
    local last_elapsed=$(jq -r '.minutes // "NA"' "${_JSON_TEST}")
    echo "Elapsed: ${time_str}"

    # Upload the key "time" in the JSON if greater than the saved time
    local last_seconds=$(jq -r '.seconds // 0' "${_JSON_TEST}")
    if [[ $elapsed -gt $last_seconds ]]; then
        _set_key_value "minutes" "${time_str}"
        _set_key_value "seconds" "${elapsed}"
        export _WELCOME_MSG="$(_get_test_welcome_msg)"
    fi
}

function _set_key_value {
    local key="${1}"
    local value="${2}"
    local tmpfile=$(mktemp)
    jq --arg t "$value" ".${key}"'= $t' "$_JSON_TEST" \
                    > "$tmpfile" && mv -f "$tmpfile" "$_JSON_TEST"
}

function opendb {
    nohup "sqlitebrowser" "${_PIPELINE_DB}"
    disown
}

function diropen {
  nohup dolphin "${_CURRENT_TEST}" >/dev/null 2>&1 &
  disown
}

function _get_tests_info {
    local MINUTES_WIDTH=6
    local TEST_NAME_WIDTH
    local -a lines=()
    local max=0

    while IFS= read -r -d '' file; do
        if ! jq empty "$file" >/dev/null 2>&1; then
            echo "Warning: invalid JSON in $file" >&2
            continue
        fi
        IFS=$'\t' read -r test_name minutes test_description < <(
            jq -r '[.test_name // "NA", .minutes // "NA", .description // "NA"] | @tsv' "$file"
        )
        test_name=${test_name//$'\n'/ }; test_name=${test_name//$'\t'/ }
        minutes=${minutes//$'\n'/ }; minutes=${minutes//$'\t'/ }
        test_description=${test_description//$'\n'/ }; test_description=${test_description//$'\t'/ }
        (( ${#test_name} > max )) && max=${#test_name}
        lines+=("$test_name"$'\t'"$minutes"$'\t'"$test_description")
    done < <(find "${_SFW_DIR}" -type f -name "${_CONFIG_FILENAME}" -print0)

    local PADDING=1
    TEST_NAME_WIDTH=$((max + PADDING))

    printf "%s\n" "${lines[@]}" | sort -t $'\t' -k1,1 | \
    while IFS=$'\t' read -r test_name minutes test_description; do
        printf "    ■ %-*s │ %*s │ %s\n" "$TEST_NAME_WIDTH" "$test_name" "$MINUTES_WIDTH" "$minutes" "$test_description"
    done
}

function inf {
    dialog --title "${_SFW_NAME} tests" --cr-wrap --no-collapse \
           --msgbox "\n\n$(_get_tests_info)" 15 150
    helpme
}

function _list_tests {
    ls --color=never -1 "${_SFW_DIR}" | grep '^test_*' | nl -w1 -s" "
}

function _list_software {
    ls --color=never -1 "${_ROOT}" | nl -w1 -s" "
}

function _select_software {
    local cmd=(dialog --keep-tite --menu "Available software" 22 76 16)
    local options=( $(_list_software) )
    local choices=$("${cmd[@]}" "${options[@]}" 2>&1 >/dev/tty)
    local idx=$(( choices * 2 - 1 ))
    echo ${options[$idx]} 
}

function _select_test {
    local cmd=(dialog --keep-tite --menu "${_SFW_NAME} tests" 22 76 16)
    resp=$?
    local options=( $(_list_tests) )
    local choices=$("${cmd[@]}" "${options[@]}" 2>&1 >/dev/tty)
    local idx=$(( choices * 2 - 1 ))
    echo ${options[$idx]}
}

function goto {
    export _SFW_NAME="$(_select_software)"
    export _SFW_DIR="${_ROOT}/${_SFW_NAME}"
    local test_dir="$(_select_test)"
    export _CURRENT_TEST="${_SFW_DIR}/${test_dir}"
    export _JSON_TEST="${_CURRENT_TEST}/${_CONFIG_FILENAME}"
    cd "${_CURRENT_TEST}"
    source "${_SELF}"
}

function switch {
    local test_dir="$(_select_test)"
    export _CURRENT_TEST="${_SFW_DIR}/${test_dir}"
    export _JSON_TEST="${_CURRENT_TEST}/${_CONFIG_FILENAME}"
    cd "${_CURRENT_TEST}"
    source "${_SELF}"
}

function _get_config_value {
    local config_path="${1}"
    local key="${2}"
    if [[ -f "${config_path}" ]]; then
        jq -r \
            --arg k \
            "${key}" '.[$k] // empty' "${config_path}"
    else
        echo "ERROR: JSON not found in: '${config_path}'." >&2
        return 1
    fi
}

function log {
    local log_file=$(find ${_LOGS} -maxdepth 2 -type f -name "compi.log" -printf '%T@ %p\n' | sort -nr | head -n 1 | cut -d' ' -f2-)
    less "${log_file}"
}

function del {
    local test_dir="$(_select_test)"
    local rm_path="${_SFW_DIR}/${test_dir}"
    local rm_config="${rm_path}/${_CONFIG_FILENAME}"
    local description="$(_get_config_value ${rm_config} description)"
    local time="$(_get_config_value ${rm_config} minutes)"
    local header=$(center_text 69 "${_SFW_NAME} - $test_dir")
    local message
read -r -d '' message << EOM
Do you want to delete?:

    ─────────────────────────────────────────────────────────────────────
    ${header}
    ─────────────────────────────────────────────────────────────────────
     ■ TIME: ${time}
     ■ DESC: ${description}
EOM
    dialog \
        --title "Delete Confirmation" \
        --cr-wrap \
        --no-collapse \
        --yesno "${message}" 15 80

    resp=$?
    helpme

    if [ $resp -eq 0 ]; then
        rm -rf "${rm_path}"
        echo "Directory '$rm_path' deleted."
    else
        echo "Operation cancelled."
    fi
}

function showenv {
    echo "_VERSION = ${_VERSION}"
    echo "_SFW_NAME = ${_SFW_NAME}"
    echo "_TEST_NAME = ${_TEST_NAME}"
    echo "_TEST_DESCRIPTION = ${_TEST_DESCRIPTION}"
    echo "_PIPELINE_ROOT = ${_PIPELINE_ROOT}"
    echo "_PIPELINE_RUNNER = ${_PIPELINE_RUNNER}"
    echo "_PIPELINE_DB = ${_PIPELINE_DB}"
    echo "_COMPI_PARAMS_TEMPLATE = ${_COMPI_PARAMS_TEMPLATE}"
    echo "_PARAMS_FILENAME = ${_PARAMS_FILENAME}"
    echo "_COMPI_PARAMS = ${_COMPI_PARAMS}"
    echo "_LOGS = ${_LOGS}"
    echo "_ROOT = ${_ROOT}"
    echo "_SFW_DIR = ${_SFW_DIR}"
    echo "_CURRENT_TEST = ${_CURRENT_TEST}"
    echo "_CONFIG_FILENAME = ${_CONFIG_FILENAME}"
    echo "_JSON_TEST = ${_JSON_TEST}"
    echo "_WELCOME_MSG = [ommited, inspect with \`helpme\`]"
    echo "PIPEMAKER_PIPELINE = ${PIPEMAKER_PIPELINE}"
}

function helpme {
    clear
    _get_test_welcome_msg
}

function ENV {
    local envHandler="${_PIPELINE_ROOT}/resources/env/tools/EnvHandler"
    "${envHandler}" "${@}"
}

function SIF_MANAGER {
    local sif_manager="${_PIPELINE_ROOT}/resources/env/tools/SIFManager"
    "${sif_manager}" "$@"
}

function _update_compi_value {
  local key="$1"
  local value="$2"

  if [ ! -e "${_COMPI_PARAMS}" ]; then
    echo "Error: File '$file' does not exist" >&2
    return 1
  fi

  if grep -Eq "^[[:space:]]*${key}=" "${_COMPI_PARAMS}"; then
    sed -i "s|^[[:space:]]*${key}=.*|${key}=${value}|" "${_COMPI_PARAMS}"
  else
    echo "Error: Key '$key' not found in '${_COMPI_PARAMS}'" >&2
    return 1
  fi
}

function _new_compi_params {
    local new_compi_params="${1}"
    if [ -e "${new_compi_params}" ]; then
        echo "Error: File '$new_compi_params' already exist" >&2
        return 1
    fi
    cp "${_COMPI_PARAMS_TEMPLATE}" "${new_compi_params}"
    _update_compi_value workingDir "${_CURRENT_TEST}"
}

function _ask_test_details {
    local result status test_name description
    result=$(dialog --stdout \
        --backtitle "${_SFW_NAME}" \
        --title " New ${_SFW_NAME} Test " \
        --form "Fill in the fields:" \
        12 70 2 \
        "Test name:"    1 1 ""  1 15 40 0 \
        "Description:"  2 1 ""  2 15 40 150
    )
    status=$?

    if [ $status -eq 0 ]; then
        # Store result in an array
        mapfile -t fields <<< "$result"
        test_name="${fields[0]}"
        description="${fields[1]}"

        # Remove spaces
        test_name="${test_name#"${test_name%%[![:space:]]*}"}"
        test_name="${test_name%"${test_name##*[![:space:]]}"}"
        description="${description#"${description%%[![:space:]]*}"}"
        description="${description%"${description##*[![:space:]]}"}"

        # OUTPUT
        echo -e "${test_name}\t${description}"

    elif [ $status -eq 1 ] || [ $status -eq 255 ]; then
        # Form cancelled
        echo -e "NA\tNA"
    else
        echo "Dialog exited with status $status"
    fi
}

function _new_config_json {
    local json_path="${1}"
    local pipel_runner="${2}"
    local test_dir="$(dirname ${json_path})"
    local result="$(_ask_test_details)"
    local name=$(cut -f1 <<< "$result")
    local description=$(cut -f2 <<< "$result")
    
    jq -n \
        --arg name "${name}" \
        --arg description "${description}" \
        --arg runner "${pipel_runner}" \
        --arg dir "${test_dir}" \
        '{test_name: $name, description: $description, pipeline_runner: $runner, test_dir: $dir}' > "${json_path}"
}

function _next_test_dir {
    # Return the name of the next test directory
    local base_dir="${_SFW_DIR}"
    local max=0
    for dir in "$base_dir"/test_*; do
        [[ -d "$dir" ]] || continue
        local num_str="${dir##*_}"
        local num=$((10#$num_str))
        (( num > max )) && max=$num
    done
    local next=$((max + 1))
    printf "test_%02d\n" "$next"
}

function new {
    local test_dirname="$(_next_test_dir)"
    export _CURRENT_TEST="${_SFW_DIR}/${test_dirname}"
    export _COMPI_PARAMS="${_CURRENT_TEST}/${_PARAMS_FILENAME}"
    export _JSON_TEST="${_CURRENT_TEST}/${_CONFIG_FILENAME}"

    # Create test directory
    mkdir "${_CURRENT_TEST}"

    # Create compi.params
    _new_compi_params "${_COMPI_PARAMS}"

    # Create config file
    _new_config_json "${_JSON_TEST}" "${_PIPELINE_RUNNER}"

    cd "${_CURRENT_TEST}"
    source "${_SELF}"
}

function tests {
    # Run the test of the current analysis
    runner test "${_COMPI_PARAMS}"
}

export -f runner
export -f run
export -f diropen
export -f opendb
export -f showenv
export -f helpme
export -f ENV
export -f SIF_MANAGER
export -f _list_software
export -f _select_software
export -f goto
export -f _list_tests
export -f _select_test
export -f switch
export -f _get_tests_info
export -f inf
export -f _get_test_welcome_msg
export -f center_text
export -f _set_key_value
export -f _update_compi_value
export -f _new_compi_params
export -f _ask_test_details
export -f _new_config_json
export -f _next_test_dir
export -f new
export -f del
export -f _get_config_value
export -f tests
export -f log

helpme
